# ==========================================
# Dylask Web - Root Environment Variables
# ==========================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dylask_db
DB_USERNAME=root
DB_PASSWORD=root_password

# Spring Boot Backend
SERVER_PORT=8080
JWT_SECRET=your_jwt_secret_key_which_should_be_long_and_secure_at_least_256_bits

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password_16_chars

# OAuth2 Google & GitHub (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret


