# ==========================================
# Dylask Web - Root Environment Variables
# ==========================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dylask_db
DB_USERNAME=root
DB_PASSWORD=root_password

# Spring Boot Backend
SERVER_PORT=8080
JWT_SECRET=your_jwt_secret_key_which_should_be_long_and_secure_at_least_256_bits

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
